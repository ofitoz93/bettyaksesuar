NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Siteyi canlıda barındırdığınız adres (mail linklerinin doğru çalışması için).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# "Stoğa gelince haber ver" e-postaları için (resend.com üzerinden ücretsiz alınabilir).
RESEND_API_KEY=
EMAIL_FROM=Betty Aksesuar <onboarding@resend.dev>
# Stok talebi geldiğinde bu adrese de bilgi maili gitsin (opsiyonel, boş bırakılırsa sadece admin panelinde görünür).
ADMIN_NOTIFICATION_EMAIL=

# PayTR ödeme altyapısı — paytr.com mağaza panelinden alınır (Ayarlar > Mağaza Bilgilerim).
# Üçü de dolu olmadan "Kredi Kartı" ödeme seçeneği checkout'ta görünmez.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# PayTR test mağazasıyla deneme yaparken 1, canlıya geçince 0 yapın.
PAYTR_TEST_MODE=1

# Supabase Dashboard > Project Settings > API > service_role key.
# YALNIZCA sunucu tarafında (PayTR webhook) kullanılır, asla tarayıcıya/istemciye sızdırılmamalı.
SUPABASE_SERVICE_ROLE_KEY=
